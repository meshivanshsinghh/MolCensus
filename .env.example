# Copy to .env and fill in. .env is git-ignored, so keys and machine paths never reach the repo.

# Only needed for the BioMiner stage (disabled by default):
BIOMINER_DIR=/path/to/BioMiner            # clone of https://github.com/jiaxianyan/BioMiner
BIOMINER_PYTHON=/path/to/envs/BioMiner/bin/python
# BioMiner reads its MLLM API key from its own config file:
#   $BIOMINER_DIR/BioMiner/config/default_open_source.yaml  (api_key, base_url, model names)
