# Copy to .env and fill in. .env is git-ignored, so keys and machine paths never reach the repo.

# Only needed for the BioMiner stage (disabled in configs/default.yaml):
BIOMINER_DIR=/path/to/BioMiner            # clone of https://github.com/jiaxianyan/BioMiner at commit 17c6161
BIOMINER_PYTHON=/path/to/envs/BioMiner/bin/python
# BioMiner reaches Gemini on Vertex AI; scripts/aws/README.md sets that up and writes BioMiner's config.

# Only needed for new Gemini calls by the recall-ceiling judge (scripts/analysis/ceiling_judges.py):
VERTEX_PROJECT=<google cloud project id>
VERTEX_SERVICE_ACCOUNT=<service account email that your gcloud login can impersonate>
